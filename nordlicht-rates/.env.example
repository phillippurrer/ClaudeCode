# Kopie als .env ablegen und anpassen.

# stdio (Client startet den Container) oder streamable-http (Dauerdienst)
NORDLICHT_TRANSPORT=stdio

# Nur bei streamable-http relevant. Im Container MUSS 0.0.0.0 stehen, sonst
# ist der Dienst gestartet, aber von aussen nicht erreichbar.
NORDLICHT_HOST=0.0.0.0
NORDLICHT_PORT=8931

# Mindestabstand zwischen zwei Abrufen desselben Hosts, in Sekunden.
# Nicht kleiner setzen: kleine Hotelseiten laufen auf schwacher Hardware.
NORDLICHT_MIN_ABSTAND_S=4

# Wie lange ein Ergebnis wiederverwendet wird (Sekunden). 0 schaltet ab.
NORDLICHT_CACHE_TTL_S=900

# Geduld pro Seite. Buchungsstrecken brauchen oft 10-20 s.
NORDLICHT_TIMEOUT_MS=45000

# Sprache und Zeitzone des Browsers. Beeinflusst, welche Waehrung und welches
# Datumsformat die Buchungsseite ausliefert.
NORDLICHT_SPRACHE=en-GB
NORDLICHT_ZEITZONE=Europe/Oslo

# Gleichzeitige Browserfenster bei reise_preise. Jedes Fenster kostet grob
# 150-250 MB. Auf einer Synology mit 2 GB RAM notfalls auf 1 setzen.
NORDLICHT_MAX_PARALLEL=3
